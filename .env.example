# Copy to .env.local for local dev. In Vercel, add these under
# Project Settings → Environment Variables instead.

# --- Client-side (VITE_ prefix required — these ARE exposed to the browser) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_PAYSTACK_PUBLIC_KEY=

# --- Server-side only (api/*.ts — NEVER prefix with VITE_, never expose these) ---
PAYSTACK_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_ACCESS_CODE=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Twilio (WhatsApp/SMS order + dispute notifications) ---
# See "Connecting Twilio" in the README for how to get these.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=
